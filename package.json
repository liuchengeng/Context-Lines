{
  "name": "contextlines",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "corepack pnpm --filter @contextlines/extension dev",
    "build": "corepack pnpm -r --if-present build",
    "typecheck": "corepack pnpm -r --if-present typecheck",
    "lint": "corepack pnpm -r --if-present lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "corepack pnpm -r --if-present test",
    "design:lint": "designmd lint DESIGN.md"
  },
  "devDependencies": {
    "@google/design.md": "^0.4.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2"
  }
}
