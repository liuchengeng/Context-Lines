# Extension build-time configuration
WXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8787
WXT_PUBLIC_QUICK_ASK_ACCESS_TOKEN=replace-with-the-same-private-token
WXT_PUBLIC_EXTENSION_KEY=
WXT_PUBLIC_USE_MOCKS=true

# Cloudflare Worker configuration. Store real keys with Wrangler secrets.
ALLOWED_EXTENSION_ID=replace-with-stable-extension-id
QUICK_ASK_ACCESS_TOKEN=replace-with-a-long-random-secret
QWEN_ASR_BASE_URL=https://replace-with-your-qwen-openai-compatible-endpoint/compatible-mode/v1
QWEN_ASR_MODEL=qwen3-asr-flash
DASHSCOPE_API_KEY=replace-with-worker-secret
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_API_KEY=replace-with-worker-secret
