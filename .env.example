# Extension build-time configuration. Safe examples only.
WXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8787
WXT_PUBLIC_SUPABASE_URL=https://example.supabase.co
WXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-public-anon-key
WXT_PUBLIC_EXTENSION_KEY=
WXT_PUBLIC_USE_MOCKS=true

# Worker runtime configuration. Set secrets with Wrangler; do not commit values.
SUPABASE_URL=https://example.supabase.co
SUPABASE_ANON_KEY=replace-with-public-anon-key
ALLOWED_EMAIL=learner@example.com
ALLOWED_EXTENSION_ID=replace-with-stable-extension-id
OPENAI_API_KEY=replace-with-worker-secret
OPENAI_TRANSCRIPTION_MODEL=gpt-live-transcribe
OPENAI_QUICK_ANALYSIS_MODEL=gpt-5.6-luna
OPENAI_DEEP_ANALYSIS_MODEL=gpt-5.6-terra

# Test-only, never enabled in production.
CONTEXTLINES_TEST_MODE=true
